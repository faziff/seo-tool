# Required in production; recommended locally if sessions should survive server restarts.
# Generate a unique random value of at least 32 characters. Never commit the real .env file.
JWT_SECRET=""

# Optional administrator identity for the admin user/credit endpoints.
ADMIN_EMAIL=""

# Optional: powers NOVA chat and AI-assisted draft generation.
# If unset, CROX uses its transparent local/rule-based fallbacks where available.
GEMINI_API_KEY=""

# Optional: enables real Google PageSpeed Insights / Lighthouse performance data.
PAGESPEED_API_KEY=""

# Optional: DataForSEO keyword data. Without these credentials, keyword output
# falls back to generated ideas and will label live search metrics unavailable.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Optional: external agent provider used by the agent integration.
AGENT_API_URL=""
AGENT_API_KEY=""

# Optional server/network/database settings.
PORT="3000"
NODE_ENV="development"
DB_PATH=""
DISABLE_HMR="false"
